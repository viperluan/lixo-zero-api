# Server
PORT=3000
# development no host; production no Docker e em npm start (scripts com cross-env sobrescrevem)
NODE_ENV=development
DB_PASSWORD=
# API/worker no host: postgresql://lixo-zero:<senha>@localhost:5432/lixo-zero
# Compose (API no container): host lixozero-db
DATABASE_URL=
SECRET_KEY=
JWT_EXPIRES_IN=24h
CORS_ORIGIN=

# Origem pública do front. O link do e-mail de redefinição aponta para cá.
# Desenvolvimento: http://localhost:5173
URL_FRONT=

# Email
GMAIL_USER=
GMAIL_PASS=

# Redis
# API/worker no host: redis://:<senha>@localhost:6379
# Compose sobrescreve com o host lixozero-redis
REDIS_URL=
REDIS_PASSWORD=
FILA_EMAIL_CONCORRENCIA=1
FILA_EMAIL_TENTATIVAS=5
FILA_EMAIL_BACKOFF_MS=5000

# Rate Limit
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_MAX=200
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_PUBLIC_READ_MAX=60
RATE_LIMIT_PUBLIC_READ_WINDOW_MS=60000
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_PASSWORD_RESET_WINDOW_MS=3600000
RATE_LIMIT_PASSWORD_RESET_CONFIRM_MAX=10
RATE_LIMIT_PASSWORD_RESET_CONFIRM_WINDOW_MS=900000
