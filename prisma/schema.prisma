generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Categoria {
  id        String @id @default(uuid())
  descricao String
  acao      Acao[]
}

model Usuario {
  id                     String             @id @default(uuid())
  nome                   String
  email                  String             @unique
  senha                  String
  status                 Boolean            @default(true)
  tipo                   String             @db.VarChar(2)
  cpf_cnpj               String             @unique @db.VarChar(14)
  senha_alterada_em      DateTime?
  acao                   Acao[]
  acao_usuario_alteracao Acao[]             @relation("usuario_alteracao")
  redefinicoes_senha     RedefinicaoSenha[]
  prorrogacoes_edicao    ProrrogacaoEdicao[]
}

model RedefinicaoSenha {
  id         String    @id @default(uuid())
  id_usuario String
  token_hash String    @unique
  expira_em  DateTime
  usado_em   DateTime?
  criado_em  DateTime  @default(now())
  usuario    Usuario   @relation(fields: [id_usuario], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([id_usuario, criado_em])
}

model Edicao {
  id                      String              @id @default(uuid())
  ano                     Int                 @unique
  data_inicio_cadastro    DateTime            @db.Date
  data_fim_cadastro       DateTime            @db.Date
  data_inicio_realizacao  DateTime            @db.Date
  data_fim_realizacao     DateTime            @db.Date
  inscricoes_abertas      Boolean             @default(false)
  vigente                 Boolean             @default(false)
  acoes                   Acao[]
  prorrogacoes            ProrrogacaoEdicao[]

  // Índice único parcial `Edicao_vigente_unica` (WHERE vigente = true) fica só
  // no SQL da migration: o schema do Prisma não declara índice parcial.
}

model ProrrogacaoEdicao {
  id                          String   @id @default(uuid())
  id_edicao                   String
  data_fim_cadastro_anterior  DateTime @db.Date
  data_fim_cadastro_nova      DateTime @db.Date
  prorrogada_em               DateTime @default(now())
  id_usuario                  String
  edicao                      Edicao   @relation(fields: [id_edicao], references: [id], onDelete: Restrict, onUpdate: Cascade)
  usuario                     Usuario  @relation(fields: [id_usuario], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([id_edicao, prorrogada_em])
  @@index([id_usuario])
}

model Acao {
  id                          String    @id @unique @default(uuid())
  nome_organizador            String
  celular                     String    @db.VarChar(11)
  titulo_acao                 String
  descricao_acao              String
  data_acao                   DateTime
  forma_realizacao_acao       String    @db.VarChar(2)
  link_divulgacao_acesso_acao String
  nome_local_acao             String
  endereco_local_acao         String
  informacoes_acao            String
  link_para_inscricao_acao    String
  tipo_publico_acao           String    @db.VarChar(2)
  orientacao_divulgacao_acao  String
  numero_organizadores_acao   Int
  data_cadastro               DateTime  @default(now())
  data_atualizacao            DateTime  @updatedAt
  situacao_acao               String    @db.VarChar(2)
  id_usuario_responsavel      String
  id_categoria                String
  id_usuario_alteracao        String
  id_edicao                   String
  categoria                   Categoria @relation(fields: [id_categoria], references: [id])
  usuario_alteracao           Usuario   @relation("usuario_alteracao", fields: [id_usuario_alteracao], references: [id])
  usuario_responsavel         Usuario   @relation(fields: [id_usuario_responsavel], references: [id])
  edicao                      Edicao    @relation(fields: [id_edicao], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([titulo_acao, id_edicao])
  @@index([id_edicao, situacao_acao, data_acao])
}
